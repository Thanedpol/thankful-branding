# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never expose to the client.
# Used by API routes for admin email lookup + signed press downloads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (contact form email notifications) ───────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Verified sender (e.g. notifications@yourdomain.com or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Where contact submissions get emailed (the admin's inbox)
CONTACT_NOTIFY_EMAIL=thank@example.com

# ─── Admin access (passcode — NO email/password) ─────────────────────────────
# The admin dashboard at /admin is unlocked by this single secret passcode.
# Set it to something only you know. Required for admin to work.
ADMIN_PASSCODE=change-me-to-a-secret

# ─── Anthropic (AI blog translation → EN + 简体中文) ──────────────────────────
# https://console.anthropic.com → API Keys. SERVER ONLY.
# Without it, blog posts simply stay in their original language.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe (shop checkout) ──────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys. SERVER ONLY.
# Without it the shop still renders; the Buy button just reports that checkout
# is not configured yet.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Developers → Webhooks → add endpoint https://YOUR_DOMAIN/api/shop/webhook
# (events: checkout.session.completed, invoice.paid) → copy the signing secret.
# Orders stay "pending" until this is set, because an unsigned event is refused.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
